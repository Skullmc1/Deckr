{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deckr",
  "version": "0.4.0",
  "identifier": "app.deckr.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deckr",
        "width": 460,
        "height": 720,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#121010"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Deckr",
    "shortDescription": "Use your phone as a mouse, keyboard and gamepad",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
